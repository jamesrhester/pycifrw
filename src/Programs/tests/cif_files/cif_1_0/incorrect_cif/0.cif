_refine_ls_matrix_type full
_refine_ls_weighting_scheme calc
_refine_ls_weighting_details 'calc w=1/[\s^2^(Fo^2^)+(0.0200P)^2^+0.0000P] where P=(Fo^2^+2Fc^2^)/3'
